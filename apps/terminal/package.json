{
  "name": "@settlement/terminal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Settlement Terminal: unified account, intent composer, route spectrum, DvP settlement, receipts (Phase H/J/K)",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview --port 5173"
  },
  "dependencies": {
    "@settlement/chain": "workspace:*",
    "@settlement/types": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  }
}
