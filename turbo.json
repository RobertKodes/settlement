{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", "schema/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "@settlement/contracts#typecheck": {
      "dependsOn": ["@settlement/contracts#build"]
    },
    "@settlement/contracts#test": {
      "dependsOn": ["@settlement/contracts#build"]
    }
  }
}
