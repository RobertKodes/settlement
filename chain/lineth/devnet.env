# Devnet parameters consumed by chain/scripts/*.sh. The quickstart's own .env is written by its wizard
# (chain/scripts/up.sh passes --l1-mode/--prover); per the upstream AGENTS.md we do not hand-edit it.
# Decisions: docs/adr/0002-settlement-and-chain-identity.md, docs/adr/0005-prover-topology.md

# L1: local Besu+Teku inside the same compose stack. No Sepolia, no gas spend.
L1_MODE=local
L1_CHAIN_ID=31648428
L1_HOST_RPC_URL=http://localhost:8445

# L2: chain ID 1337 is TEMPORARY for the local devnet (ADR-0002). Changing it means editing the three
# genesis/prover files listed in chain/lineth/README.md and running `make devnet-reset`.
L2_CHAIN_ID=1337
# Sequencer RPC (LINEA namespace, linea_estimateGas). The follower node is on 8745, WS on 8746.
L2_HOST_RPC_URL=http://localhost:8645
L2_NODE_HOST_RPC_URL=http://localhost:8745

# Prover: dev mode (dummy proofs). The prover image is linux/amd64 only; on Apple Silicon this is mandatory.
WIZARD_PROVER=dev
PROVER_DEV_OVERRIDE=true

# Extra flags for ./scripts/start.sh on boot (e.g. --no-pull once images are local, --verbose).
DEVNET_START_FLAGS=
