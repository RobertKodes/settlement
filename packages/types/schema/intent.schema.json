{
  "$id": "https://schemas.settlement.local/intent.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "intentId": {
      "type": "string",
      "pattern": "^int_[A-Za-z0-9]{6,64}$"
    },
    "accountId": {
      "type": "string",
      "pattern": "^acct_[A-Za-z0-9]{6,64}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "settle",
        "transfer",
        "swap",
        "bridge",
        "onramp",
        "offramp"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,12}$"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "chainId": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "asset",
        "amount"
      ]
    },
    "destination": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,12}$"
        },
        "recipient": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "chainId": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "asset",
        "recipient"
      ]
    },
    "constraints": {
      "default": {
        "requireAtomicity": false
      },
      "type": "object",
      "properties": {
        "maxSlippageBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "requireAtomicity": {
          "default": false,
          "type": "boolean"
        },
        "allowedVenues": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "native",
              "arc",
              "external"
            ]
          }
        }
      }
    }
  },
  "required": [
    "action",
    "source",
    "destination"
  ]
}
