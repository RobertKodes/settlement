{
  "$id": "https://schemas.settlement.local/settlement-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "settlementId": {
      "type": "string",
      "pattern": "^stl_[A-Za-z0-9]{6,64}$"
    },
    "intentId": {
      "type": "string",
      "pattern": "^int_[A-Za-z0-9]{6,64}$"
    },
    "executionId": {
      "type": "string",
      "pattern": "^exe_[A-Za-z0-9]{6,64}$"
    },
    "route": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "venue": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "shareBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "chainId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "venue",
          "shareBps"
        ]
      }
    },
    "transactions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chainId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "txHash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "blockNumber": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "chainId",
          "txHash"
        ]
      }
    },
    "legs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^acct_[A-Za-z0-9]{6,64}$"
          },
          "to": {
            "type": "string",
            "pattern": "^acct_[A-Za-z0-9]{6,64}$"
          },
          "amount": {
            "type": "object",
            "properties": {
              "asset": {
                "type": "string",
                "pattern": "^[A-Z0-9]{2,12}$"
              },
              "amount": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "chainId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "asset",
              "amount"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "amount"
        ]
      }
    },
    "fees": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "execution": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "crosschain": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        }
      },
      "required": [
        "network",
        "execution",
        "crosschain"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "settledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "softFinality": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "PENDING",
            "INCLUDED"
          ]
        },
        "l2BlockNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "state"
      ]
    },
    "l1Finality": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "PENDING",
            "SUBMITTED",
            "FINALIZED"
          ]
        },
        "l1TxHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "l1BlockNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "state"
      ]
    },
    "reconciliation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "MATCHED",
            "BREAK"
          ]
        },
        "runId": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "status"
      ]
    }
  },
  "required": [
    "settlementId",
    "intentId",
    "route",
    "transactions",
    "legs",
    "fees",
    "createdAt",
    "softFinality",
    "l1Finality",
    "reconciliation"
  ]
}
