{
  "$id": "https://schemas.settlement.local/quote.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "quoteId": {
      "type": "string",
      "pattern": "^q_[A-Za-z0-9]{6,64}$"
    },
    "input": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,12}$"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "chainId": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "asset",
        "amount"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,12}$"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "chainId": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "asset",
        "amount"
      ]
    },
    "route": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "venue": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "shareBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "chainId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "venue",
          "shareBps"
        ]
      }
    },
    "fees": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "execution": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "crosschain": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        }
      },
      "required": [
        "network",
        "execution",
        "crosschain"
      ]
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "executionScore": {
      "type": "number"
    }
  },
  "required": [
    "quoteId",
    "input",
    "output",
    "route",
    "fees",
    "expiresAt"
  ]
}
